# Local development defaults. Do not put production secrets in this file.
TALENTAUDIT_ENVIRONMENT=local
TALENTAUDIT_LOG_LEVEL=INFO
TALENTAUDIT_DATABASE_URL=postgresql+psycopg://talentaudit:talentaudit@db:5432/talentaudit
TALENTAUDIT_DB_CONNECT_TIMEOUT_SECONDS=3

# Local document-processing limits. Override these in the deployment environment.
TALENTAUDIT_DOCUMENT_STORAGE_PATH=var/documents
TALENTAUDIT_ALLOWED_DOCUMENT_MIME_TYPES=["application/pdf","text/plain"]
TALENTAUDIT_MAX_UPLOAD_BYTES=5242880
TALENTAUDIT_MAX_PDF_PAGES=25
TALENTAUDIT_MAX_EXTRACTED_TEXT_CHARS=1000000
